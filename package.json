{
  "name": "@sudobility/screenwriter_client",
  "version": "0.1.5",
  "description": "Network client, react-query hooks and Yjs sync client for Fadewright",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "BUSL-1.1",
  "author": "Sudobility",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "clean": "rimraf dist"
  },
  "files": ["dist/**/*", "CLAUDE.md"],
  "dependencies": {
    "@sudobility/screenwriter_types": "^0.1.3",
    "@sudobility/writing_core": "^0.1.2",
    "yjs": "^13.6.32"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.5",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "happy-dom": "^20.0.8",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.4"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johnqh/screenwriter_client.git"
  }
}
